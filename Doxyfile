#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

PROJECT_NAME           = BetaTrader
PROJECT_BRIEF          = "Native C++ FX trading engine, exchange simulator, FIX gateway, and trader terminal"
OUTPUT_DIRECTORY       = ./docs
CREATE_SUBDIRS         = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
MARKDOWN_SUPPORT       = YES

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
WARN_NO_PARAMDOC       = YES

#---------------------------------------------------------------------------
# Configuration options related to warning and progress messages
#---------------------------------------------------------------------------

QUIET                  = YES
WARN_LOGFILE           = doxygen_warnings.log

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

INPUT                  = docs/doxygen-mainpage.md \
                         common \
                         exchange \
                         client

FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.md
RECURSIVE              = YES
EXCLUDE                = docs/html \
                         docs/client-ui \
                         vendor

EXCLUDE_PATTERNS       = */tests/* \
                         */mocks/*

USE_MDFILE_AS_MAINPAGE = docs/doxygen-mainpage.md

#---------------------------------------------------------------------------
# Configuration options related to the HTML output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
HTML_CODE_FOLDING      = YES
ENUM_VALUES_PER_LINE   = 1
SEARCHENGINE           = YES
HTML_COLORSTYLE        = TOGGLE

HTML_HEADER            = docs/header.html
HTML_FOOTER            = docs/footer.html
HTML_EXTRA_STYLESHEET  = docs/stylesheet.css \
                            docs/awesome.css \
                            docs/sidebar.css \
                            docs/sidebar-only-drkmode.css
HTML_EXTRA_FILES       =


#---------------------------------------------------------------------------
# Configuration options related to the LaTeX output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Configuration options related to diagram generator tools
#---------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
UML_LOOK               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES